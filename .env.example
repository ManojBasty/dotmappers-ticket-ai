# LLM strategy: auto | groq | ollama | mock
LLM_PROVIDER=auto

# Assessment-target Groq model. Override when your Groq project supports a different model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional custom CSV path. Leave empty to use data/support_tickets.csv.
TICKETS_CSV_PATH=

# Keep in-memory query results bounded.
MAX_QUERY_ROWS=200

# Streamlit -> FastAPI connection.
API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Optional: set this for live-age semantics. Empty = deterministic dataset max timestamp.
ANOMALY_REFERENCE_AT=
